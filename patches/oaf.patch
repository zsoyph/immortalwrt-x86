+define Package/appfilter/postinst
+#!/bin/sh
+# The init script ships outside the package file list and is copied into
+# place here so the buildroot default_postinst never auto-enables it; the
+# service stays disabled until the user turns it on from System/Startup.
+install -d -m 0755 "$${IPKG_INSTROOT:-/}/etc/init.d"
+install -m 0755 "$${IPKG_INSTROOT:-/}/usr/share/oaf/appfilter.init" \
+	"$${IPKG_INSTROOT:-/}/etc/init.d/appfilter"
+exit 0
+endef
 
 
