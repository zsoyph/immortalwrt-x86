#!/bin/sh /etc/rc.common

# START 92->42: 抢在 uhttpd(50) 之前拉起进程。
# LuCI 菜单注册时用 pgrep 探测 quickstart，若访问时进程未起，
# 「首页」会被注册成 redirect_fallback(跳 status/overview) 并写入
# /tmp/luci-indexcache 固化，之后进程起来了也一直跳概览。
START=42
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/quickstart serve --unix /var/run/quickstart/local.sock
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
	# 清除 quickstart 未运行期间生成的坏菜单缓存（自愈，boot 时 /tmp 为空则 no-op）
	rm -f /tmp/luci-indexcache.*.json 2>/dev/null
}
