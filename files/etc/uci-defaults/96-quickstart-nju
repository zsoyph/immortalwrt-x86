#!/bin/sh
# Keep the NJU / ImmortalWrt quickstart patch and the fixed boot script across
# package upgrades.
#
# The image already ships the patched binary (md5 3476eec5...). On first boot
# keep a copy in /root and install an idempotent rc.local guard: when an
# `apk upgrade` of quickstart restores the stock 0.13.0 binary
# (md5 d510ae81...), put the patched copy back automatically. A genuinely NEW
# upstream version has a different md5 and is deliberately left alone.
#
# The init script is backed up too: it starts quickstart at 42 (before uhttpd
# at 50) and purges a stale LuCI menu cache, which otherwise pins the "Home"
# entry to redirect_fallback (jump to admin/status) after a boot race.

bin=/usr/sbin/quickstart
backup=/root/quickstart.patched-immortal
init=/etc/init.d/quickstart
init_backup=/root/quickstart.init.patched-immortal
rc=/etc/rc.local
fixdir=/root/oaf-single-menu
oaf_ctrl=/usr/lib/lua/luci/controller/oaf.lua
qs_index=/www/luci-static/quickstart/index.js
qs_view=/usr/lib/lua/luci/view/quickstart/main.htm

[ -f "$bin" ] || exit 0
# Belt and braces: restore the executable bit even if the image builder lost it.
chmod 755 "$bin" || exit 1
cp "$bin" "$backup" 2>/dev/null || exit 1
chmod 644 "$backup"

if [ -f "$init" ]; then
    chmod 755 "$init" || exit 1
    cp "$init" "$init_backup" 2>/dev/null || exit 1
    chmod 644 "$init_backup"
    # A sysupgrade that keeps /etc can retain the old S92 link even though the
    # shipped script now declares START=42; rebuild both links from scratch.
    "$init" disable
    "$init" enable
fi

# Three package-owned files carry the single-menu fix (oaf controller plus the
# quickstart home JS/template). Back them up so an apk upgrade that restores the
# stock files can be repaired by the rc.local guard below.
if [ -f "$oaf_ctrl" ] && [ -f "$qs_index" ] && [ -f "$qs_view" ]; then
    mkdir -p "$fixdir" || exit 1
    cp "$oaf_ctrl" "$fixdir/oaf.lua" 2>/dev/null || exit 1
    cp "$qs_index" "$fixdir/index.js" 2>/dev/null || exit 1
    cp "$qs_view" "$fixdir/main.htm" 2>/dev/null || exit 1
    chmod 644 "$fixdir"/* 2>/dev/null
fi

[ -f "$rc" ] || printf '#!/bin/sh\n\nexit 0\n' > "$rc"
if ! grep -q 'qs-guard' "$rc"; then
    # Drop the stock trailing "exit 0" and append the guard instead.
    sed -i '/^exit[[:space:]][[:space:]]*0[[:space:]]*$/d' "$rc"
    cat >> "$rc" <<'EOF'

# quickstart 补丁守卫：包升级把二进制/启动脚本还原成官方原版时自动恢复
if command -v md5sum >/dev/null 2>&1 && [ -f /root/quickstart.patched-immortal ]; then
    cur=$(md5sum /usr/sbin/quickstart 2>/dev/null | awk '{print $1}')
    if [ "$cur" = "d510ae81ed99e30f1ab0ff1fcb204689" ]; then
        logger -t qs-guard "stock quickstart detected, restoring patched binary"
        cp /root/quickstart.patched-immortal /usr/sbin/quickstart
        chmod 755 /usr/sbin/quickstart
        /etc/init.d/quickstart restart
    fi
fi
# 官方 init（START=92、无菜单缓存自愈）被还原时，恢复 42 + 缓存清理
if [ -f /root/quickstart.init.patched-immortal ] && ! grep -q '^START=42' /etc/init.d/quickstart 2>/dev/null; then
    logger -t qs-guard "stock quickstart init detected, restoring START=42 self-heal"
    cp /root/quickstart.init.patched-immortal /etc/init.d/quickstart
    chmod 755 /etc/init.d/quickstart
    /etc/init.d/quickstart disable
    /etc/init.d/quickstart enable
    /etc/init.d/quickstart restart
fi
# 单菜单守卫：升级 luci-app-oaf / luci-app-quickstart 还原官方文件时自动恢复
if [ -d /root/oaf-single-menu ]; then
    changed=0
    ctrl=/usr/lib/lua/luci/controller/oaf.lua
    index=/www/luci-static/quickstart/index.js
    view=/usr/lib/lua/luci/view/quickstart/main.htm
    if ! grep -Fq '"应用过滤"' "$ctrl" 2>/dev/null || grep -Fq '"admin", "services", "appfilter"' "$ctrl" 2>/dev/null; then
        cp /root/oaf-single-menu/oaf.lua "$ctrl"
        changed=1
    fi
    if grep -Fq 'admin/services/appfilter' "$index" 2>/dev/null || ! grep -Fq 'admin/services/oaf' "$index" 2>/dev/null; then
        cp /root/oaf-single-menu/index.js "$index"
        changed=1
    fi
    if ! grep -Fq '0.12.10-r1qs2' "$view" 2>/dev/null; then
        cp /root/oaf-single-menu/main.htm "$view"
        changed=1
    fi
    if [ "$changed" = 1 ]; then
        logger -t oaf-menu-guard "restored single OAF menu after package upgrade"
        rm -f /tmp/luci-indexcache.*.json
    fi
fi

exit 0
EOF
fi
chmod 755 "$rc"
exit 0
